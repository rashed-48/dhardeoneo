# Required in production. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHELF_SECRET=

# Port to listen on. Most hosts inject this automatically.
PORT=4000

# Postgres. Required — the app will not boot without it.
# Local development, matching the container in the README:
#   postgres://shelf:devpass@localhost:5433/shelf
# Neon gives you a URL like:
#   postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/shelf?sslmode=require
DATABASE_URL=

# Where cover art fetched after deploy is written. The database no longer
# lives here, so this only needs a volume if those covers must survive.
SHELF_DATA_DIR=/data

# Minutes of inactivity before a session lapses (1-1440). Defaults to 30.
# SHELF_SESSION_IDLE_MINUTES=30

# Optional overrides
# SHELF_DB_POOL=10
# SHELF_COVERS_DIR=/app/server/covers
# SHELF_WEB_DIST=/app/web/dist

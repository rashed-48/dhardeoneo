# Required in production. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHELF_SECRET=

# Port to listen on. Most hosts inject this automatically.
PORT=4000

# Where writable state lives. Mount a persistent volume here to keep the
# database across deploys; without one the app re-seeds itself on boot.
SHELF_DATA_DIR=/data

# Minutes of inactivity before a session lapses (1-1440). Defaults to 30.
# SHELF_SESSION_IDLE_MINUTES=30

# Optional overrides
# SHELF_DB=/data/shelf.db
# SHELF_COVERS_DIR=/app/server/covers
# SHELF_WEB_DIST=/app/web/dist
